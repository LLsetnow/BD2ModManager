{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BD2ModManager",
  "version": "4.3.4",
  "identifier": "com.bruhnn.BD2ModManager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BD2ModManager",
        "width": 1000,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "devtools": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: http://asset.localhost bd2assets: http://bd2assets.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/BD2ModPreview.exe": "resources/BD2ModPreview.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QUFFMDM2NkY4NTZCNDMKUldSRGE0VnZOdUNxZHIyRnNTcEV2bDZZWUhZeHdaV0dXUHozbEZPY3RWMDMzdEJnd2RxalFsOU0K",
      "endpoints": [
        "https://github.com/LLsetnow/BD2ModManager/releases/latest/download/latest.json"
      ]
    }
  }
}
